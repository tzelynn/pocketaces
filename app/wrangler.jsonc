// Cloudflare Worker: serves the built app (dist/) as static assets and runs worker/index.ts for /api/*.
// Deploy steps: specs/app-hosting-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketaces",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // everything else is served straight from the assets, without invoking the Worker
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  // SQLite-backed Durable Objects are the kind available on the Workers Free plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "observability": { "enabled": true }
}
